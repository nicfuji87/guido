# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Nunca prefixar com NEXT_PUBLIC_.
# É a chave que o worker usa para ler e escrever g_jobs, que não tem policy.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Chatwoot (white label CWMKT)
# ---------------------------------------------------------------------------
CHATWOOT_BASE_URL=

# Platform API — cria conta, agente e inbox no cadastro self-service.
# Token de super admin: só no servidor.
CHATWOOT_PLATFORM_TOKEN=

# Segredo compartilhado para validar que o webhook veio mesmo do Chatwoot.
CHATWOOT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
